# ==========================================================================
# הגדרות סביבה - michlol-ivr
# ==========================================================================
#
# חשוב מאוד: כאן נמצאים רק סודות תשתית, כלומר סודות ששייכים למי שמתקין
# את המערכת. הטוקן האישי של משתמש ימות **אינו** נמצא כאן. הוא מוגדר
# בהגדרות השלוחה במערכת ימות המשיח ומגיע למודול בכל בקשה.
#
# אף אחד מהערכים כאן אינו חובה. בלי שום הגדרה המערכת רצה ועובדת,
# רק בלי היסטוריה ומועדפים.
# ==========================================================================


# --- מקור התוכן -----------------------------------------------------------

# איזה אתר משמש כמקור: michlol או wikipedia
# ברירת מחדל: michlol
SEARCH_PROVIDER=michlol

# כתובות הממשק. יש לשנות רק אם המקור עבר כתובת.
# MICHLOL_API_BASE=https://www.hamichlol.org.il/api.php
# WIKIPEDIA_API_BASE=https://he.wikipedia.org/w/api.php

# מדיניות ה-API של מדיה-ויקי מחייבת זיהוי אמיתי עם דרך ליצירת קשר.
# מומלץ מאוד לעדכן לכתובת המייל שלכם.
HTTP_USER_AGENT=MichlolIVR/1.0 (telephone accessibility; +mailto:you@example.com)


# --- אחסון ----------------------------------------------------------------

# none (ברירת מחדל) | huggingface | memory
# בלי אחסון המערכת עובדת, אבל אין היסטוריה, מועדפים והעדפות קבועות.
STORAGE_DRIVER=none

# נדרש רק כש-STORAGE_DRIVER=huggingface
# מאגר מסוג dataset בצורת שם-משתמש/שם-מאגר
# HF_DATASET_REPO=your-username/michlol-ivr-data

# טוקן Hugging Face עם הרשאת כתיבה. סוד תשתית - לעולם לא בקוד המקור.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx


# --- פרטיות ---------------------------------------------------------------

# מלח לגיבוב מספרי הטלפון. בלעדיו המערכת לא שומרת היסטוריה ומועדפים כלל,
# וזו התנהגות מכוונת: עדיף בלי תכונה מאשר עם מזהי משתמש חלשים.
# יש לייצר מחרוזת אקראית ארוכה, ולא לשנות אותה אחר כך - שינוי שלה
# מנתק את כל המשתמשים הקיימים מהנתונים שלהם.
# ליצירה:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# USER_ID_SALT=


# --- תמלול ----------------------------------------------------------------

# yemot (ברירת מחדל, מומלץ) - זיהוי הדיבור המובנה של ימות המשיח
# external - פונקציית הפייתון api/transcribe.py
TRANSCRIPTION_MODE=yemot

# נדרש רק כש-TRANSCRIPTION_MODE=external
# TRANSCRIBE_URL=https://your-project.vercel.app/api/transcribe


# --- כוונון עדין (כל אלה אופציונליים) -------------------------------------

# LOG_LEVEL=info                 # debug | info | warn | error | silent
# HTTP_TIMEOUT_MS=8000           # פסק זמן לפנייה למקור חיצוני
# HTTP_MAX_RETRIES=2             # ניסיונות חוזרים לשגיאות זמניות בלבד
# CACHE_SEARCH_TTL_MS=600000     # תוקף מטמון חיפוש, 10 דקות
# CACHE_ARTICLE_TTL_MS=1800000   # תוקף מטמון ערכים, 30 דקות
# DEFAULT_RESULT_COUNT=5         # מספר תוצאות ברירת מחדל
# SEGMENT_CHARS=450              # אורך מקטע הקראה בתווים
# MAX_SEGMENTS=60                # מספר מקטעים מרבי לערך
# MAX_HISTORY_ITEMS=20
# MAX_FAVORITES=50
# HISTORY_ENABLED_BY_DEFAULT=true
