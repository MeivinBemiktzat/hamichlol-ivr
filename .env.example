# === פרטי מערכת ימות המשיח (לשימוש שרת-בלבד - אין לחשוף בצד לקוח) ===
# מספר המערכת שלכם בימות המשיח (username עבור Login)
YEMOT_SYSTEM_NUMBER=0771234567

# סיסמת הניהול של המערכת (password עבור Login)
# זהו "הטוקן הרציני" בפועל: ה-Management API של ימות לא מנפיק טוקן API
# קבוע מהאתר בנפרד מהסיסמה - יש לבצע קריאת Login (עם מספר המערכת+הסיסמה)
# כדי לקבל טוקן session זמני, וזה בדיוק מה שהקוד ב-lib/yemotSession.js
# עושה אוטומטית מאחורי הקלעים. הסיסמה עצמה לעולם לא נשלחת שוב אחרי
# ה-Login הראשון, רק הטוקן שמתקבל ממנו.
YEMOT_SYSTEM_PASSWORD=your-management-password

# קידומת נתיב אופציונלית לפני נתיב הקובץ בהורדה (DownloadFile), אם
# יתברר בבדיקה בפועל שהשרת שלכם דורש קידומת כמו "ivr2:". השאירו ריק
# אם לא ידוע / אם הנתיב בלי קידומת עובד.
YEMOT_RECORDINGS_PATH_PREFIX=

# === שירות התמלול הקיים (transcribe.py) ===
# ה-URL המלא של פונקציית ה-Python שמתמללת קול לטקסט (לאחר deployment
# נפרד או כפונקציה נוספת באותו פרויקט Vercel - ראה README).
TRANSCRIBE_SERVICE_URL=https://YOUR-VERCEL-DEPLOYMENT.vercel.app/api/transcribe
